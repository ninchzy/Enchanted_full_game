{
  "name": "enchanted",
  "productName": "Enchanted",
  "description": "Enchanted",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "icon": "node tools/make-icon.mjs",
    "app": "vite build && electron .",
    "dist": "vite build && electron-builder --win"
  },
  "devDependencies": {
    "@fontsource/dotgothic16": "^5.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "pixi.js": "^8.6.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.enchanted.game",
    "productName": "Enchanted",
    "directories": {
      "output": "release/desktop",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Enchanted Setup ${version}.${ext}",
      "shortcutName": "Enchanted"
    },
    "portable": {
      "artifactName": "Enchanted ${version} (portable).${ext}"
    }
  }
}
